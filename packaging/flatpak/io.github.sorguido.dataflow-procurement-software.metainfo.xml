<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.sorguido.dataflow-procurement-software</id>
  <name>DataFlow</name>
  <summary>Manage RFQs, procurement data, supplier evaluations, and KPI analysis</summary>
  <summary xml:lang="it">Gestisci RFQ, dati acquisti, valutazioni fornitori e analisi KPI</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <developer id="io.github.sorguido">
    <name>Guido Sorarù</name>
  </developer>

  <description>
    <p>
      DataFlow is a desktop application for procurement teams. It helps manage
      Requests for Quotation, supplier offers, attachments, purchase data,
      supplier evaluations, Value Stream Mapping events, KPI analysis, and
      Excel or PDF exports.
    </p>
    <p xml:lang="it">
      DataFlow è un'applicazione desktop per uffici acquisti. Aiuta a gestire
      richieste di offerta, offerte fornitori, allegati, dati di acquisto,
      valutazioni fornitori, eventi Value Stream Mapping, analisi KPI ed export
      Excel o PDF.
    </p>
    <p>
      The application is designed as a native desktop workflow for buyers who
      need structured RFQ tracking, supplier comparison, saving analysis, cost
      avoidance monitoring, and potential supplier derisking in one tool.
    </p>
    <p xml:lang="it">
      L'applicazione è pensata come flusso desktop nativo per buyer che devono
      gestire tracciamento RFQ, confronto fornitori, analisi saving,
      monitoraggio cost avoidance e derisking fornitori potenziali in un unico
      strumento.
    </p>
  </description>

  <launchable type="desktop-id">io.github.sorguido.dataflow-procurement-software.desktop</launchable>
